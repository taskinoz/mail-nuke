# Mail Nuke v2
# Copy this file to .env before running Docker Compose.

# Host port bound to 127.0.0.1 by docker-compose.yml.
MAIL_NUKE_PORT=8765

# Optional Fernet key. When omitted, Mail Nuke generates data/secret.key.
# Keep an externally managed key out of source control and back it up securely.
MAIL_NUKE_SECRET_KEY=

# Complete mailbox reconciliation interval; minimum five minutes.
MAIL_NUKE_RECONCILE_INTERVAL_SECONDS=300

# Automatic group retraining interval; minimum one hour, default seven days.
MAIL_NUKE_TRAIN_INTERVAL_SECONDS=604800

# MAIL_NUKE_DATA_DIR is fixed to /data by docker-compose.yml. The ./data host
# directory is bind-mounted there, so it normally does not need to be set here.
