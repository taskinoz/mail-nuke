IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true

IMAP_SOURCE_FOLDER=INBOX
IMAP_SPAM_FOLDER=Junk
IMAP_POLL_SECONDS=60

SPAM_THRESHOLD=0.90 # The threshold above which an email is considered spam.
MARK_SEEN_ON_SPAM=true # Whether to mark emails as seen when they are moved to the spam folder.
DRY_RUN=true # If true, actions will be logged but not executed. Set to false to actually move emails.
PROCESS_ONLY_UNSEEN=true # If true, only process emails that are unseen.

STATE_FILENAME=imap-worker-state.json
ACTION_LOG_FILENAME=imap-actions.jsonl

DEBUG=false # Set to true to enable debug logging, which includes listing IMAP folders on startup.

# Mail Nuke v2 foundation
MAIL_NUKE_DATA_DIR=./data
MAIL_NUKE_PORT=8765
# Optional Fernet key. When omitted, v2 generates data/secret.key.
# Keep an externally supplied production key out of source control.
MAIL_NUKE_SECRET_KEY=
# Complete move/deletion reconciliation interval; minimum five minutes.
MAIL_NUKE_RECONCILE_INTERVAL_SECONDS=300
# Automatic group retraining interval; default is seven days.
MAIL_NUKE_TRAIN_INTERVAL_SECONDS=604800
